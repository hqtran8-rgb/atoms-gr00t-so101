# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real hosts, users, or key paths.
#
# transfer_policy_from_lambda.sh reads: LAMBDA_SSH_HOST, LAMBDA_SSH_USER,
# LAMBDA_SSH_KEY, LAMBDA_REMOTE_DEPLOY_PATH, JETSON_WORK_DIR
#
# run_policy_load_test.sh reads: JETSON_WORK_DIR, JETSON_HF_CACHE_DIR,
# GR00T_DOCKER_IMAGE (optional, defaults to gr00t-orin:latest)

# --- Lambda training host (fine-tuning side) ---
LAMBDA_SSH_HOST=xxx.xxx.xxx.xxx
LAMBDA_SSH_USER=your-lambda-username
LAMBDA_SSH_KEY=$HOME/.ssh/your_lambda_key
LAMBDA_REMOTE_DEPLOY_PATH=/path/on/lambda/to/deploy/policy_C_v2_realonly

# --- Jetson AGX Orin (inference/deployment side) ---
# JETSON_WORK_DIR is your working directory on the Jetson, e.g. a path
# under an external NVMe mount such as /media/<user>/<nvme-label>/<project>.
JETSON_WORK_DIR=/path/on/jetson/to/working/dir
JETSON_HF_CACHE_DIR=/path/on/jetson/to/hf_cache

# --- Docker ---
GR00T_DOCKER_IMAGE=gr00t-orin:latest

# --- Policy server (rollout scripts connect here; loopback by default) ---
POLICY_SERVER_HOST=127.0.0.1
POLICY_SERVER_PORT=5555
